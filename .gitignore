# Dependencias
node_modules/

# Build de Next.js
.next/
out/
next-env.d.ts

# Base de datos SQLite generada en runtime (se recrea + reseedea sola)
data/
*.db
*.db-shm
*.db-wal

# Variables de entorno reales (solo .env.example se versiona)
.env
.env.local

# Logs y basura de SO
*.log
npm-debug.log*
.DS_Store

# Basura de Windows y caches de compilacion
# Windows adjunta un flujo :Zone.Identifier a los archivos que se descargan; en
# WSL aparece como un archivo aparte y se colaria en cualquier `git add -A`.
*:Zone.Identifier
# Cache incremental de TypeScript (lo genera `tsc` y el tsconfig tiene incremental)
*.tsbuildinfo
