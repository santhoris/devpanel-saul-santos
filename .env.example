# Secreto usado para firmar los JWT (HS256). Debe tener >= 32 caracteres.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres

# Ruta del archivo SQLite. Relativa a la raiz del proyecto por defecto.
DB_PATH=./data/devpanel.db

# Maximo de intentos fallidos de login por IP+email dentro de la ventana de 15 min
LOGIN_RATE_LIMIT=10
